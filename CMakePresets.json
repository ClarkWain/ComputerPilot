{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/libtorch",
        "DP_WITH_TORCH": "ON",
        "DP_WITH_OCR": "ON",
        "OpenCV_DIR": "${sourceDir}/.deps/opencv-build",
        "DP_TEST_OCR": "${sourceDir}/models/ocr",
        "DP_TEST_MODEL": "${sourceDir}/models/icon_detect_v3/model.pt",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "core-only",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DP_STATIC_RUNTIME": "ON",
        "DP_WITH_TORCH": "OFF",
        "DP_WITH_OCR": "OFF",
        "DP_TEST_MODEL": "",
        "DP_TEST_OCR": "",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
