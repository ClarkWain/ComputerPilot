  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Get compact controls and semantic profiles by default. change_mode:delta returns only changes since this connection's last complete observation of the same window and view; the first call or a reset returns full state. Unchanged screenshots are omitted, including inline images; small changes may return a positioned capture.kind:patch with a fullPath. Input coordinates still use the full image frame. detail:full restores complete control fields and longer text. mode:image skips UI Automation and profile discovery; mode:both includes controls/profiles and a screenshot. Screenshots return a local capture.path by default; image_delivery:inline also sends an MCP image. max_edge sets the screenshot's longest pixel edge (default 1600 for full windows; regions retain source size); it never enlarges the capture. Basic point coordinates follow the returned coordinateSpace; screenshot coordinates map automatically. Optional region uses window-relative physical pixels for a lossless detail view. Restores focus unless activate:false.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "change_mode": {
          "default": "full",
          "enum": [
            "full",
            "delta"
          ],
          "type": "string"
        },
        "activate": {
          "default": true,
          "type": "boolean"
        },
        "detail": {
          "default": "compact",
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        },
        "image_delivery": {
          "default": "path",
          "enum": [
            "path",
            "inline"
          ],
          "type": "string"
        },
        "max_edge": {
          "maximum": 32000,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "default": "controls",
          "enum": [
            "controls",
            "image",
            "both"
          ],
          "type": "string"
        },
        "region": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            },
            "x": {
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "type": "object"
        },
        "window_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "window_id"
      ],
      "type": "object"
    },
    "name": "get_window_state"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "PREFERRED when get_window_state returns a matching profile. Execute 1..256 app actions using its examples. Omit profile to auto-select exactly one compatible profile; explicit ids are revalidated. Execution manages controls, colors, focus and waits. Stops on failure; inspect the result before retrying.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "minLength": 1,
                "type": "string"
              },
              "args": {
                "type": "object"
              }
            },
            "required": [
              "action",
              "args"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "window_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "actions"
      ],
      "type": "object"
    },
    "name": "execute_semantic"
  },
