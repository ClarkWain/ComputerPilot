    },
    "description": "List all open windows. No parameters. Read the returned titles and pids to identify the intended window_id; does not activate or resize.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "name": "list_windows"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Get controls by default; mode:image/both adds a screenshot capped at 1600 pixels. Basic point coordinates follow the returned coordinateSpace; screenshot coordinates map automatically. Optional region uses window-relative physical pixels for a lossless detail view (also capped at 1600). Restores focus unless activate:false.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "activate": {
          "default": true,
          "type": "boolean"
        },
        "mode": {
          "default": "controls",
          "enum": [
            "controls",
            "image",
            "both"
          ],
          "type": "string"
        },
        "region": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            },
            "x": {
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "type": "object"
        },
        "window_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "window_id"
      ],
      "type": "object"
    },
    "name": "get_window_state"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "PREFERRED when get_window_state returns a matching profile. Execute 1..256 app actions using its examples. Omit profile to auto-select exactly one compatible profile; explicit ids are revalidated. Native execution manages controls, colors, focus and waits. Stops on failure; inspect the result before retrying.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "minLength": 1,
                "type": "string"
              },
              "args": {
                "type": "object"
              }
            },
            "required": [
              "action",
              "args"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "window_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "actions"
      ],
      "type": "object"
    },
    "name": "execute_semantic"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
