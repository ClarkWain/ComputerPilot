cmake_minimum_required(VERSION 3.29)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED DP_BINARY_DIR)
  set(DP_BINARY_DIR "${root}/build/core/Release")
endif()
if(NOT DEFINED DP_PACKAGE_DIR)
  set(DP_PACKAGE_DIR "${root}/out/dist/DesktopPilot")
endif()
get_filename_component(binary "${DP_BINARY_DIR}" ABSOLUTE)
get_filename_component(package "${DP_PACKAGE_DIR}" ABSOLUTE)
if(EXISTS "${binary}/desktop-pilot.exe")
  set(program "desktop-pilot.exe")
  set(example_command "C:/tools/DesktopPilot/bin/desktop-pilot.exe")
elseif(EXISTS "${binary}/desktop-pilot")
  set(program "desktop-pilot")
  set(example_command "/absolute/path/DesktopPilot/bin/desktop-pilot")
else()
  message(FATAL_ERROR "Build first or set DP_BINARY_DIR to the binary directory")
endif()
if(EXISTS "${package}")
  message(FATAL_ERROR "Use a new DP_PACKAGE_DIR; refusing to mix old and new artifacts")
endif()
file(MAKE_DIRECTORY "${package}/bin" "${package}/licenses")
file(GLOB dlls "${binary}/*.dll")
file(COPY "${binary}/${program}" ${dlls} DESTINATION "${package}/bin")
if(EXISTS "${binary}/desktop-pilot-onboarding.exe")
  file(COPY "${binary}/desktop-pilot-onboarding.exe" DESTINATION "${package}/bin")
endif()
file(COPY "${root}/README.md" "${root}/AGENTS.md" "${root}/LICENSE" "${root}/CHANGELOG.md"
  "${root}/OPERATIONS.md" "${root}/BATCH-RELIABILITY.md" "${root}/THIRD_PARTY_NOTICES.md" "${root}/CONTRIBUTING.md"
  DESTINATION "${package}")
file(COPY "${root}/docs" "${root}/skills" "${root}/examples" "${root}/profiles" DESTINATION "${package}")
file(COPY "${root}/third_party/nlohmann/LICENSE.MIT" DESTINATION "${package}/licenses/nlohmann")
file(COPY "${root}/third_party/rapidocr/LICENSE" DESTINATION "${package}/licenses/rapidocr")
get_filename_component(build_root "${binary}" DIRECTORY)
if(EXISTS "${binary}/licenses/webp")
  file(COPY "${binary}/licenses/webp" DESTINATION "${package}/licenses")
elseif(EXISTS "${build_root}/licenses/webp")
  file(COPY "${build_root}/licenses/webp" DESTINATION "${package}/licenses")
endif()
if(dlls)
  foreach(dependency libtorch onnxruntime-win-x64-1.23.2 opencv-4.10.0)
    file(GLOB notices "${root}/.deps/${dependency}/LICENSE*" "${root}/.deps/${dependency}/NOTICE*" "${root}/.deps/${dependency}/ThirdPartyNotices*")
    if(notices)
      file(COPY ${notices} DESTINATION "${package}/licenses/${dependency}")
    endif()
  endforeach()
endif()
file(WRITE "${package}/mcp.example.json"
  "{\n  \"mcpServers\": {\n    \"desktop-pilot\": {\n      \"command\": \"${example_command}\",\n      \"args\": [\"serve\"]\n    }\n  }\n}\n")
message(STATUS "Packaged ${package}; no model weights or local configuration included")
