cmake_minimum_required(VERSION 3.29)
get_filename_component(DP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(MAKE_DIRECTORY "${DP_ROOT}/.deps/downloads")
function(fetch_checked url destination sha256)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" existing)
    if(existing STREQUAL sha256)
      message(STATUS "Already verified: ${destination}")
      return()
    endif()
  endif()
  get_filename_component(parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  message(STATUS "Downloading ${destination}")
  file(DOWNLOAD "${url}" "${destination}.part"
    EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON TIMEOUT 1800 SHOW_PROGRESS)
  file(RENAME "${destination}.part" "${destination}")
endfunction()
